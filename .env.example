# Credentials and endpoint. Choose the model and workload in each launcher.
API_BASE=https://api.example.com/v1
HARBOR_EVO_API_KEY=change-me
HARBOR_MODEL_INFO='{"max_input_tokens":176000,"max_output_tokens":16000,"input_cost_per_token":0.0,"output_cost_per_token":0.0}'

# Optional E2B credentials.
# E2B_API_KEY=change-me

# Optional: extra HTTP headers applied to every LLM request, for gateways that
# require their own routing/session headers, plus a client-identifying user
# agent. Example (opencode go requires a stable session id per conversation):
# HARBOR_LLM_EXTRA_HEADERS='{"x-opencode-session": "embodied-harness"}'
# HARBOR_LLM_USER_AGENT=embodied-harness/1.0

# Optional remote Docker daemon. The address below is documentation-only.
# REMOTE_DOCKER_HOST=tcp://192.0.2.10:2375
# DOCKERHUB_USERNAME=your-dockerhub-username
# DOCKERHUB_TOKEN=your-dockerhub-token

# Edit the parameter block at the top of scripts/evolve.sh or
# scripts/evaluate.sh, then run that script.
